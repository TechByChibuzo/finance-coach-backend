# Copy this file to .env and fill in your values
# .env is gitignored and should never be committed

# Database
DB_URL=jdbc:postgresql://localhost:5432/financecoach
DB_USERNAME=admin
DB_PASSWORD=

# JWT
JWT_SECRET=

# Claude (Anthropic)
CLAUDE_API_KEY=

# OpenAI (Embeddings)
OPENAI_API_KEY=

# Plaid
PLAID_CLIENT_ID=
PLAID_SECRET=

# Stripe
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_MONTHLY_PRICE_ID=
STRIPE_PREMIUM_YEARLY_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=

# SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Finance Coach

# Security
JASYPT_ENCRYPTOR_PASSWORD=

# AWS (Bedrock + S3 exports); credentials come from the default chain (profile locally, task role in ECS)
AWS_REGION=us-east-1
S3_EXPORT_BUCKET=

# App
APP_FRONTEND_URL=http://localhost:5173
APP_API_URL=http://localhost:8090

# Monitoring: bearer token for /actuator/prometheus and /actuator/metrics (required in prod)
METRICS_TOKEN=
SPRING_PROFILES_ACTIVE=dev
